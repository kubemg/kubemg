FROM node:22-alpine

# node:22-alpine vendors an older npm CLI whose own bundled dependencies
# (tar, brace-expansion, picomatch, sigstore, ip-address) carry known CVEs.
# Upgrading npm itself pulls in patched copies of all of them.
RUN npm install -g npm@latest

WORKDIR /app

RUN chown -R node:node /app
USER node

COPY --chown=node:node package.json package-lock.json ./
RUN npm ci

COPY --chown=node:node . .

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host"]
