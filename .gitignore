# Compiled binaries. `make backend-build` and `make agent-build` drop these in
# the tree, and the backend one is ~90 MB.
/backend/server
/agent/kubemg-agent
*.exe
*.dll
*.so
*.dylib
*.test
*.out

# Go workspace files — local to whoever set them up.
go.work
go.work.sum

# Node
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local editor, assistant and planning files. These are the private working
# surface of this repository's development process, not part of the product,
# and they stay local. Anything meant for readers of the public repository
# belongs in README.md.
.claude/*
/CLAUDE.md
/AGENT_RULES.md
/PROJECT_KNOWLEDGE.md
/implementation_plan.md
/claude_prompt.md
/roadmap.md
/notes.txt
/.cursorrules
/.clinerules
/.windsurfrules
/.agents/
/.claude/
/.cursor/
/.windsurf/
/.aider*

# Credentials and local overrides. The dev stack's defaults live in
# docker-compose.yml; anything real belongs in an untracked env file.
.env
.env.*
!.env.example
*.local
*.pem
*.key
!**/testdata/**/*.pem
!**/testdata/**/*.key
kubeconfig
kubeconfig-*.yaml
*.kubeconfig

# Certificates and keystores. The bastion mints its own TLS material at boot and
# an operator mounts real material in; neither has any business in git.
*.crt
*.cer
*.der
*.csr
*.srl
*.p12
*.pfx
*.jks
*.keystore
*.p8
*.ppk
!**/testdata/**/*.crt
!**/testdata/**/*.cer
/certs/
/tls/
id_rsa*
id_ecdsa*
id_ed25519*
.netrc
.npmrc
*.htpasswd

# Rendered agent install packages, checked out locally to apply by hand. The
# secret inside carries a live cluster registration token — this is the shape of
# the one credential that has already been committed here once.
/kubemg-agent/
/agent-install*/

# Recorded terminal sessions, if the recording directory is ever pointed inside
# the tree. A recording holds everything that crossed a production shell.
/recordings/
*.cast
*.cast.gz

# Rendered agent install packages. These carry a cluster registration token —
# they are generated per cluster and must never be committed.
kustomize.tar.gz
*-kubemg-agent.yaml
*-kubemg-agent.tar.gz

# Local Postgres data if the compose volume is ever bind-mounted.
/data/
/pgdata/

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.sw?
.DS_Store
Thumbs.db

# Coverage
coverage/
coverage.out
*.cover

# Brand kit — source assets, not shipped from here.
brand/
