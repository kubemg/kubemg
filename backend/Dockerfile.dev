FROM golang:1.26-alpine

WORKDIR /app

RUN apk add --no-cache git curl \
    && addgroup -g 1000 app && adduser -D -u 1000 -G app app \
    && mkdir -p /go/pkg/mod /root/.cache/go-build /etc/kubemg/tls /var/lib/kubemg/recordings \
    && chmod 755 /root \
    && chown -R app:app /go /root/.cache/go-build /app /etc/kubemg/tls /var/lib/kubemg/recordings

ENV GOCACHE=/root/.cache/go-build
USER app

COPY --chown=app:app go.mod go.sum ./
RUN go mod download

COPY --chown=app:app . .

EXPOSE 8080

CMD ["go", "run", "./cmd/server"]
