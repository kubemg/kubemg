# Local overrides for the dev stack. Copy to `.env` — which is gitignored — and
# edit. Everything here has a working default in docker-compose.yml; you only
# need this file when the defaults are wrong for your machine.

# The address a *target cluster* dials to reach this bastion. It is baked into
# every generated agent install command, so loopback only works for a cluster
# running on this same host. Use the LAN/VPN address otherwise.
# KUBEMG_PUBLIC_URL=https://192.0.2.10:8443

# Extra TLS SANs for the self-signed certificate, beyond the public URL's host
# and loopback. Every name kubectl, the console and your agents dial.
# KUBEMG_TLS_HOSTS=kubemg-backend,backend,192.0.2.10

# Origins the browser console is served from, if not localhost:5173.
# KUBEMG_CORS_ORIGINS=http://localhost:5173,http://192.0.2.10:5173

# Encrypts terminal session recordings at rest. 32 bytes, hex or base64:
#   openssl rand -base64 32
# Unset, recordings are written in plaintext and the server says so at boot.
# KUBEMG_SESSION_RECORDING_KEY=
